#!/bin/sh
#  Compila k4term y lo deja instalado en el sistema.
#
#  Instala en el HOME y no en /usr: nada de sudo, nada que se pise con los
#  paquetes de la distribución, y desinstalar es borrar cuatro rutas que este
#  mismo fichero enumera al final.
#
#      ./instalar              compila y copia los binarios
#      ./instalar --enlace     enlaza a target/release en vez de copiar
#      ./instalar --quitar     deshace la instalación
#
#  `--enlace` es para quien esté tocando el código: con enlaces, cada
#  `cargo build --release` queda puesto sin volver a pasar por aquí. Con
#  copias —lo de por defecto— la instalación no depende de que el repositorio
#  siga donde está.

set -eu

RAIZ=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)

BIN="${XDG_BIN_HOME:-$HOME/.local/bin}"
APPS="${XDG_DATA_HOME:-$HOME/.local/share}/applications"
ICONOS="${XDG_DATA_HOME:-$HOME/.local/share}/icons/hicolor"

LADOS="512 256 128 64 48 32 24 16"

nota()  { printf '  %s\n' "$1"; }
aviso() { printf '  \033[33m!\033[0m %s\n' "$1"; }
mal()   { printf '  \033[31m✗\033[0m %s\n' "$1" >&2; exit 1; }
bien()  { printf '  \033[32m✓\033[0m %s\n' "$1"; }

#  La línea que se mete en tu configuración de shell. Lleva marca propia
#  para poder quitarla luego sin adivinar: se busca la marca y se borra ella
#  y la de debajo, que es todo lo que este guion escribe ahí.
MARCA='#  k4term: integración de la shell (la pone y la quita ./instalar)'

#  Qué shells sabemos integrar y dónde. Se mira SI EXISTE el fichero, no cuál
#  es tu $SHELL: es normal tener el login en una shell y usar otra en el
#  terminal, y en ese caso integrar solo una deja la mitad a medias.
para_cada_shell() {
    accion=$1
    "$accion" zsh  "$HOME/.zshrc"                  "$RAIZ/integracion/k4term.zsh"
    "$accion" fish "$HOME/.config/fish/config.fish" "$RAIZ/integracion/k4term.fish"
}

integrar_una() {
    nombre=$1; rc=$2; guion=$3
    [ -f "$rc" ] || return 0
    [ -f "$guion" ] || return 0

    if grep -qF "$guion" "$rc" 2>/dev/null; then
        bien "$nombre ya estaba integrada"
        return 0
    fi

    cp "$rc" "$rc.k4.bak"
    {
        printf '\n%s\n' "$MARCA"
        printf 'source %s\n' "$guion"
    } >> "$rc"
    bien "$nombre integrada (copia de lo de antes en $rc.k4.bak)"
}

desintegrar_una() {
    nombre=$1; rc=$2; guion=$3
    [ -f "$rc" ] || return 0
    grep -qF "$guion" "$rc" 2>/dev/null || return 0

    cp "$rc" "$rc.k4.bak"
    #  La marca, la línea de debajo y el blanco que las separaba de lo tuyo:
    #  si no, cada instalar/quitar te deja un hueco más en la configuración.
    #  Por eso los blancos se retienen en vez de imprimirse al vuelo.
    #
    #  Con awk y no con `sed -i` porque el rango `/marca/,+1` es de GNU y
    #  este guion es sh a secas.
    awk -v m="$MARCA" '
        BEGIN { pend = 0; saltar = 0 }
        saltar > 0        { saltar--; next }
        /^[ \t]*$/        { pend++; next }
        $0 == m           { if (pend > 0) pend--; suelta(); saltar = 1; next }
                          { suelta(); print }
        END               { suelta() }
        function suelta() { while (pend-- > 0) print ""; pend = 0 }
    ' "$rc" > "$rc.k4.nuevo" && mv "$rc.k4.nuevo" "$rc"
    bien "$nombre desintegrada"
}

quitar() {
    rm -f "$BIN/k4term" "$BIN/k4term-isla" "$APPS/k4term.desktop"
    for lado in $LADOS; do
        rm -f "$ICONOS/${lado}x${lado}/apps/k4term.png"
    done
    bien "quitado de $BIN, $APPS y $ICONOS"
    para_cada_shell desintegrar_una
    exit 0
}

ENLACE=0
SHELL_TAMBIEN=1
for arg in "$@"; do
    case "$arg" in
        --enlace) ENLACE=1 ;;
        --sin-shell) SHELL_TAMBIEN=0 ;;
        --quitar) quitar ;;
        *) mal "no conozco la opción $arg" ;;
    esac
done

printf '\n  k4term\n\n'

########################################################################
#  Lo que hace falta para compilar
########################################################################
command -v cargo >/dev/null 2>&1 || mal "no encuentro cargo: instala Rust."

#  El núcleo VT de ghostty se compila con Zig, y con UNA versión de Zig: la
#  0.14.1. Si no está en el PATH, el build.rs busca en .context/zig.
if ! command -v zig >/dev/null 2>&1 && [ ! -x "$RAIZ/.context/zig/zig" ]; then
    aviso "no hay zig ni en el PATH ni en .context/zig"
    nota "ejecuta ./scripts/bootstrap-zig.sh y vuelve"
    exit 1
fi

if [ ! -e "$RAIZ/vendor/ghostty/build.zig" ]; then
    aviso "falta el ghostty vendorizado"
    nota "ejecuta: git -C $RAIZ submodule update --init --recursive"
    exit 1
fi

########################################################################
#  Compilar
########################################################################
nota "compilando en release (la primera vez tarda un rato)…"
( cd "$RAIZ" && cargo build --release -p k4term -p k4term-isla ) \
    || mal "la compilación ha fallado; mira lo de arriba."
bien "compilado"

########################################################################
#  Los dos binarios
########################################################################
#  Son dos porque son dos cosas: `k4term` es la ventana, y `k4term-isla` es
#  la misma sesión sin ventana, la que sirve la rejilla a la barra. La barra
#  arranca el segundo por su cuenta, así que tiene que estar en el PATH.
mkdir -p "$BIN"
for prog in k4term k4term-isla; do
    origen="$RAIZ/target/release/$prog"
    [ -x "$origen" ] || mal "no se ha generado $origen"
    rm -f "$BIN/$prog"
    if [ "$ENLACE" -eq 1 ]; then
        ln -s "$origen" "$BIN/$prog"
    else
        cp "$origen" "$BIN/$prog"
    fi
done
if [ "$ENLACE" -eq 1 ]; then
    bien "enlazados en $BIN (apuntan a target/release)"
else
    bien "instalados en $BIN"
fi

case ":$PATH:" in
    *":$BIN:"*) ;;
    *) aviso "$BIN no está en tu PATH: añádelo o no se encontrará k4term." ;;
esac

########################################################################
#  El icono
########################################################################
#  A todos los tamaños y no solo a uno grande: quien lo pinta a 16 px es la
#  lista de ventanas, y un 512 reescalado ahí se deshace.
if [ -f "$RAIZ/assets/k4term-512.png" ]; then
    for lado in $LADOS; do
        destino="$ICONOS/${lado}x${lado}/apps"
        mkdir -p "$destino"
        cp "$RAIZ/assets/k4term-$lado.png" "$destino/k4term.png"
    done
    bien "icono instalado"
else
    aviso "faltan los PNG del icono: genéralos con python3 assets/icono.py"
fi

########################################################################
#  La entrada de escritorio
########################################################################
#  `StartupWMClass` tiene que ser el mismo app_id que pide la ventana, o el
#  compositor no sabe que esa ventana es esta aplicación y la lista de tareas
#  la enseña sin icono y sin nombre.
mkdir -p "$APPS"
cat > "$APPS/k4term.desktop" <<'FIN'
[Desktop Entry]
Type=Application
Version=1.5
Name=k4term
GenericName=Terminal
Comment=La terminal de la casa k4
Exec=k4term
Icon=k4term
Terminal=false
Categories=System;TerminalEmulator;
Keywords=shell;prompt;command;commandline;cmd;terminal;consola;
StartupNotify=true
StartupWMClass=k4term
X-TerminalArgExec=-e
X-TerminalArgDir=-d
FIN
bien "entrada de escritorio en $APPS"

#  Refrescar las cachés, si el sistema las tiene. No son obligatorias: sin
#  ellas la entrada aparece igual, solo que puede tardar en salir.
command -v update-desktop-database >/dev/null 2>&1 \
    && update-desktop-database -q "$APPS" 2>/dev/null || true
command -v gtk-update-icon-cache >/dev/null 2>&1 \
    && gtk-update-icon-cache -qtf "$ICONOS" 2>/dev/null || true

########################################################################
#  Los ajustes
########################################################################
#  Un fichero de ejemplo, con todo comentado y los valores de fábrica a la
#  vista. No cambia nada —todo lo que va con almohadilla es lo que ya hace—,
#  pero es la diferencia entre poder configurarlo y enterarse de que se puede:
#  sin él, la única pista de que existen estas cuatro claves está en el código.
#
#  Si ya hay uno, no se toca. Es tuyo.
CONF="${XDG_CONFIG_HOME:-$HOME/.config}/k4term/k4term.conf"
if [ -f "$CONF" ]; then
    nota "tus ajustes siguen en $CONF"
else
    mkdir -p "$(dirname "$CONF")"
    cat > "$CONF" <<'FIN'
#  Ajustes de k4term.
#
#  Se leen al abrir y se siguen en caliente: al guardar este fichero, las
#  ventanas ya abiertas se enteran. Lo que no se diga se queda de fábrica,
#  así que puedes borrar lo que no te interese en vez de dejarlo puesto.
#
#  Con la barra k4 delante no hace falta editarlo a mano: lo mismo está en
#  Ajustes → Terminal, y lo que se toca ahí se escribe aquí línea a línea,
#  sin llevarse por delante tus comentarios.

# fuente    = MesloLGS Nerd Font Mono
# tamaño    = 13
# margen    = 12

#  Cristal: 1 es opaca. Por debajo se ve lo que hay detrás.
# opacidad  = 0.94
#  Radio de las esquinas. 0 = que redondee el compositor, que en Hyprland ya
#  lo hace y con el radio de tu tema.
# radio     = 0

#  El rastro que deja el cursor al moverse. `no` lo apaga; un número es
#  cuántos fantasmas deja.
# estela    = si
#  Atenúa lo anterior al último mandato, para que lo de ahora destaque.
# tranquilo = no

#  Con qué arrancar. Vacío = tu $SHELL.
# shell     = /usr/bin/fish
FIN
    bien "ajustes de ejemplo en $CONF"
fi

########################################################################
#  La integración de la shell
########################################################################
#  Es lo que hace que la barra sepa qué mandato corre y cuánto lleva: la
#  shell lo cuenta por OSC y sin esto k4term funciona, pero la isla no se
#  entera de nada. Se pone sola porque no ponerla es dejar la instalación a
#  medias; con --sin-shell no se toca nada tuyo.
if [ "$SHELL_TAMBIEN" -eq 1 ]; then
    para_cada_shell integrar_una
    nota "abre una shell nueva para que tenga efecto"
else
    aviso "sin tocar tu shell: la barra no sabrá qué mandato estás corriendo"
fi

printf '\n'
